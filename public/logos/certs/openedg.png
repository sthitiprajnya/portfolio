            <style>
            @import url('https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Bree+Serif&display=swap');

::view-transition-old(root) {
  animation-delay: 500ms;
}

::view-transition-new(root) {
  animation: circle-in 500ms;
/*   animation-timing-function: linear(0, 0.234 11.8%, 0.403 18.4%, 0.624 24.7%, 0.999 33.3%, 0.76 39.9%, 0.705 42.6%, 0.687 45.2%, 0.703 47.7%, 0.753 50.3%, 0.999 57.7%, 0.89 61.8%, 0.865 63.6%, 0.857 65.3%, 0.865 67%, 0.887 68.8%, 0.999 74.5%, 0.957 77.5%, 0.944 80.2%, 0.954 82.7%, 1 88.2%, 0.988 91.9%, 1); */
}

@keyframes move-in {
  from { translate: 0 -100%; }
  to { translate: 0  0; }
}

@keyframes circle-in {
  from { clip-path: circle(0% at 50% 0%); }
  to { clip-path: circle(120% at 50% 0%); }
}

@keyframes appear {
    from {
        opacity: 0;
        scale: .9;
        /* clip-path: inset(100% 100% 0 0); */
    }
    to {
        opacity: 1;
        scale: 1;
        /* clip-path: inset(0 0 0 0); */
    }
}

.block {
    animation: appear linear;
    animation-timeline: view();
    animation-range: entry 0% cover 15%;
}

:root {
  @media (prefers-color-scheme: light) {
    --theme: ☀️;
    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    --theme: 🌑;
    color-scheme: dark;
  }
}

html {
    scrollbar-gutter: stable;
}

body {
  color-scheme: light;

    --clr-dodger-blue: #298af8;
    --clr-science-blue: #0665d4;
    --clr-denim: #1373e1;
    --clr-mine-shaft: #333333;
    --clr-red: #c83737;
    --clr-green: #5aa02c;
    --clr-gray: #525252;

    --clr-primary: #0066ff;
    --clr-white: #ffffff;
    --clr-black: #000000;
    --clr-background: #f9fbff;
    --clr-text: #212529;
    --clr-card-bg: linear-gradient(180deg, rgb(238 247 255) 0%, rgba(238, 250, 255, 0.1) 100%);
    --clr-border: #0066ff2e;
    --clr-boxshadow: #dbdbdb4a;
    --clr-table-border: #dee2e6;
    --clr-transparency: #ffffff9e;

    --clr-code: #004ad4;
    --clr-code-bg: #eff5ff;

    --light-green: #fcffed;
    --dark-green: #657211;

    --light-gray: #eef3ff;
    --dark-gray: #282828;

    --light-blue: #f6f9ff;
    --vibrant-blue: #0066ff;

    --light-yellow: #fff5da;
    --dark-yellow: #ffbc00;

    --light-pink: #fcf2f3;
    --dark-pink: #d2334b;

    --light-purple: linear-gradient(145deg, rgba(88, 20, 252, 0.1) 0%, rgba(19, 233, 160, 0.1) 100%);
    --dark-purple: #5814fc;

    --light-teal: #ebffff;
    --dark-teal: #008080;

    --c-light-green: #f9fff5;
    --c-dark-green: #73a950;

    --c-light-blue: #d1e3ff;
    --c-vibrant-blue: #2d81ff;

    --light-orange: #fff2e9;
    --dark-orange: #fd6824;

  @container style(--theme: 🌑) {
    color-scheme: dark;

    --clr-dodger-blue: #298af8;
    --clr-science-blue: #0665d4;
    --clr-denim: #1373e1;
    --clr-mine-shaft: #f9fbff;
    --clr-red: #c83737;
    --clr-green: #5aa02c;
    --clr-gray: #a1a1a1;

    --clr-primary: #0066ff;
    --clr-white: #10171d;
    --clr-black: #000000;
    --clr-background: #111212;
    --clr-text: #f9fbff;
    --clr-card-bg: #13181d;
    --clr-border: #0066ff2e;
    --clr-boxshadow: #001e4b;
    --clr-table-border: #0066ff2e;
    --clr-transparency: #0000004a;

    --clr-code: #b3ceff;
    --clr-code-bg: #eff5ff38;

    --light-green: #232320;
    --dark-green: #657211;

    --light-gray: #292c34;
    --dark-gray: #282828;

    --light-blue: #272d3a;
    --vibrant-blue: #0066ff;

    --light-yellow: #2a2821;
    --dark-yellow: #ffbc00;

    --light-pink: #322b2c;
    --dark-pink: #d2334b;

    --light-purple: linear-gradient(145deg, rgba(88, 20, 252, 0.1) 0%, rgba(19, 233, 160, 0.1) 100%);
    --dark-purple: #5814fc;

    --light-teal: #273333;
    --dark-teal: #008080;

    --c-light-green: #f9fff5;
    --c-dark-green: #73a950;

    --c-light-blue: #d1e3ff;
    --c-vibrant-blue: #2d81ff;

    --light-orange: #fff2e9;
    --dark-orange: #fd6824;

  }
}

body {
    font-family: "Lexend", sans-serif;
    font-weight: 300;
    font-optical-sizing: auto;
    overflow-x: hidden;
    background: var(--clr-background) !important;
    color: var(--clr-text);
    cursor: url("https://pythoninstitute.org/assets/6a06ef381f8b0033997860.cur"), auto;
}

code {
    color: var(--clr-code);
    background-color: var(--clr-code-bg);
    border-radius: 4px;
    padding: .25rem;
    border: 1px solid var(--clr-border);
    filter: drop-shadow(0 0 0.75rem #00000009);
}

/*********************************** THEME SWITCHER ******************************/

.dark-mode-logo {
  display: none;
}

.switch {
  font-size: 17px;
  position: relative;
  display: inline-block;
  width: 4em;
  height: 2.2em;
  border-radius: 30px;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  scale: .5;
  transform: translate(-20px, -10px);
}

/* Hide default HTML checkbox */
.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

/* The slider */
.slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #2a2a2a;
  transition: 0.4s;
  border-radius: 30px;
  overflow: hidden;
}

.slider:before {
  position: absolute;
  content: "";
  height: 1.2em;
  width: 1.2em;
  border-radius: 20px;
  left: 0.5em;
  bottom: 0.5em;
  transition: 0.4s;
  transition-timing-function: cubic-bezier(0.81, -0.04, 0.38, 1.5);
  box-shadow: inset 8px -4px 0px 0px #fff;
}

.switch input:checked + .slider {
  background-color: #00a6ff;
}

.switch input:checked + .slider:before {
  transform: translateX(1.8em);
  box-shadow: inset 15px -4px 0px 15px #ffcf48;
}

.star {
  background-color: #fff;
  border-radius: 50%;
  position: absolute;
  width: 5px;
  transition: all 0.4s;
  height: 5px;
}

.star_1 {
  left: 2.5em;
  top: 0.5em;
}

.star_2 {
  left: 2.2em;
  top: 1.2em;
}

.star_3 {
  left: 3em;
  top: 0.9em;
}

.switch input:checked ~ .slider .star {
  opacity: 0;
}

.cloud {
  width: 3.5em;
  position: absolute;
  bottom: -1.4em;
  left: -1.1em;
  opacity: 0;
  transition: all 0.4s;
}

.switch input:checked ~ .slider .cloud {
  opacity: 1;
}



/*********************************************************************************/
/******************** ACCORDION **************/


.accordion {
  background-color: var(--clr-white);
  color: var(--clr-text);
  cursor: pointer;
  padding: 18px;
  width: 100%;
  border: none;
  text-align: left;
  outline: none;
  font-size: 15px;
  transition: 0.4s;
  border-radius: 8px;
  border: 1px solid var(--clr-border);
}

.acc-active, .accordion:hover {
    background-color: var(--clr-background);
    border: 1px solid var(--clr-primary);
    color: #0066ff;
}

.panel {
  padding: 0 1.5rem;
  background-color: var(--clr-backround);
  max-height: 0;
  overflow: hidden;
  border-radius: 8px;
  filter: drop-shadow(0 0 0.75rem #00000009);
  transition: max-height 0.2s ease-out;
}

.panel-inside {
    margin-block: 1rem;
}

.accordion:after {
  content: '+';
  font-size: 1rem;
  color: #777;
  float: right;
  margin-left: 5px;
}

.acc-active:after {
  content: "–";
  font-size: 1rem;
}

/**************************************************/
.card {
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--clr-border);
    filter: drop-shadow(0 0 0.75rem #00000009);
    background: #EEFAFF;
    background: var(--clr-card-bg) !important;
}

.card-important {
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--clr-border);
    filter: drop-shadow(0 0 0.75rem #00000009);
    background: var(--clr-card-bg);
    overflow: hidden;
}

.card-important::before {
    content: '';
    position: absolute;
    height: 100%;
    width: 5px;
    inset: 0;
    background: var(--clr-primary);
}


.cookie-bar {
    width: 500px;
    bottom: 50px;
    right: 70px;
    padding: 2rem;
    filter: drop-shadow(0 0 0.75rem #0066ff29);
    border-radius: 16px;
    background-color: #ffffffbf;
    color: #000;
    border: 1px solid var(--clr-border);
    backdrop-filter: blur(7px);

    h4 {
        font-size: 1.5rem;
        color: var(--clr-primary);
    }

    a {
        color: var(--clr-primary) !important;
    }

    @media(width < 1000px) {
      width: 100%;
      right: 0;
    }
}

.cookie-bar .cookie-bar-description {
    font-size: .9rem;
}

h1, h2, h3, h4 {
    font-family: "Bree Serif", serif;
}

.link {
    text-decoration: none;
    color: var(--clr-primary);
    border-radius: 8px;
    padding-block: .25rem;

    transition: all 300ms ease;
}

.link:hover {
    background-color: #eff5ff;
    outline: 1px solid #0066ff50;
    border-radius: 8px;
}

/******************* LAYOUT ***********************/

.even-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-block: 1rem;
    width: 100%;
    position: relative;
}

.three-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-block: 1rem;
    width: 100%;
    position: relative;
}

.two-to-one {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
    margin-block: 1rem;
    width: 100%;
}

.one-to-two {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    margin-block: 1rem;
    width: 100%;
}

.three-to-one {
    display: grid;
    grid-template-columns: 3fr 1fr;
    gap: 2rem;
    margin-block: 1rem;
    width: 100%;
}

.one-to-three {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 2rem;
    margin-block: 1rem;
    width: 100%;
}

/********************* MEDIA QUERIES *******************/

@media(width < 1000px) {
    .even-columns {
        grid-template-columns: 1fr;
        gap: 2rem;
        justify-items: center;
    }

    .two-to-one,
    .one-to-two,
    .three-to-one,
    .one-to-three,
    .three-columns {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }
}

/*********************************** NEW NAVIGATION **********************************************************/

header {
    position: relative;
    z-index: 999999;
    background: #0000;
    /*    box-shadow: 0px 5px 5px #dbdbdb33; */
}

header hr {
    margin: 0;
    padding: 0;
    border: 1px solid var(--clr-border) !important;
}

header ul {
  list-style: none;
  padding: 0;
  margin: 0;
  /* Color highlighting when pressed on mobile devices */
  /*-webkit-tap-highlight-color: transparent;*/
}

header a {
  text-decoration: none;
}


select {
    word-wrap: normal;
    font-size: 11px;
    border-radius: 8px;
    border: 1px solid var(--clr-border);
}

.noselect {
  -webkit-touch-callout: none; /* iOS Safari */
    -webkit-user-select: none; /* Safari */
     -khtml-user-select: none; /* Konqueror HTML */
       -moz-user-select: none; /* Old versions of Firefox */
        -ms-user-select: none; /* Internet Explorer/Edge */
            user-select: none; /* Non-prefixed version, currently
                                  supported by Chrome, Edge, Opera and Firefox */
    cursor: auto;
}

.nav {
  display: flex;
  height: 3.5rem;
  background: #0000;
}

.nav__logo,
.nav__burger,
.nav__close {
  color: var(--clr-white);
}

.nav__logo img {
  width: 170px;
}

.nav__data {
  height: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-inline: 1rem;
  padding-block: 2rem;
}

.nav__toggle {
  position: relative;
  width: 32px;
  height: 32px;
}

.nav__burger,
.nav__close {
  position: absolute;
  width: max-content;
  height: max-content;
  inset: 0;
  margin: auto;
  font-size: 1.25rem;
  cursor: pointer;
  transition: opacity .1s, transform .4s;
  fill: #0066ff !important;
}

.nav__close {
  opacity: 0;
}

/* Navigation for mobile devices */
@media screen and (max-width: 1118px) {
  .nav__menu {
    position: absolute;
    left: 0;
    top: 10rem;
    width: 100%;
    height: calc(100vh - 3.5rem);
    overflow: auto;
    pointer-events: none;
    opacity: 0;
    transition: top .6s, opacity .5s;
  }
  .nav__menu::-webkit-scrollbar {
    width: 0;
  }
  .nav__list {
    background-color: var(--clr-white);
    padding-top: 1rem;
  }
  .nav__data {
    width: 100%;
  }
}

.nav__link {
  color: var(--clr-text);

  font-weight: 650;
  padding: 1.25rem 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background-color .3s;
}

.nav__link:hover {
  color: var(--clr-primary);
}

/* Show menu */
.show-menu {
  opacity: 1;
  top: 3.5rem;
  pointer-events: initial;
}

/* Show icon */
.show-icon .nav__burger {
  opacity: 0;
  transform: rotate(90deg);
}
.show-icon .nav__close {
  opacity: 1;
  transform: rotate(90deg);
}

@media only screen and (max-width: 768px) {
    #topNavi {
        display: flex !important;
    }

    .top-navi .container-md {
        align-items: center;
        display: flex;
        flex-wrap: inherit;
        justify-content: flex-end !important;
    }
}

.top-navi-bg {
    position: relative;
    z-index: 10000000000;
}

/*=============== DROPDOWN ===============*/
.dropdown__item {
  cursor: pointer;
}

.dropdown__arrow {
  font-size: 1.25rem;
  font-weight: initial;
  transition: transform .4s;
}

.dropdown__link,
.dropdown__sublink {
  padding: .75rem;
  color: var(--clr-text);
  background-color: var(--clr-white);
  display: flex;
  align-items: center;
  column-gap: .5rem;
  font-weight: 500;
  border-radius: 8px;
  transition: background-color .3s;
}

.dropdown__sublink {
    font-weight: 300 !important;
}

.dropdown__link i,
.dropdown__sublink i {
  font-size: 1.25rem;
  font-weight: initial;
}

.dropdown__link:hover,
.dropdown__sublink:hover {
  background-color: var(--clr-primary);
  color: var(--clr-white);

}

.dropdown__sublink:hover .dropdown__submenu {
    background: var(--clr-primary);
}

.dropdown__menu,
.dropdown__submenu {
  max-height: 0;
  z-index: 1000;
  overflow: hidden;
  transition: max-height .6s ease-out;
  box-shadow: 0px 0px 10px var(--clr-boxshadow);
  border: 1px solid var(--clr-border);
  /* border-top: none; */
  border-radius: 8px;
  background: var(--clr-background);
}

/* Show dropdown menu & submenu */
.dropdown__item:hover .dropdown__menu,
.dropdown__subitem:hover > .dropdown__submenu {
  max-height: 1000px;
  transition: max-height .6s ease-in;

}

/* Rotate dropdown icon */
.dropdown__item:hover .dropdown__arrow {
  transform: rotate(180deg);
}

/*=============== DROPDOWN SUBMENU ===============*/
.dropdown__add {
  margin-left: auto;
}

.dropdown__sublink {
  background-color: var(--clr-white);
}

/*=============== BREAKPOINTS ===============*/
/* For small devices */
@media screen and (max-width: 340px) {
  .container {
    margin-inline: 1rem;
  }

  .nav__link {
    padding-inline: 1rem;
  }
}

/* For large devices */
@media screen and (min-width: 1118px) {
  .container {
    margin-inline: auto;
  }

  .nav {
    height: 5.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav__toggle {
    display: none;
  }

  .nav__list {
    height: 100%;
    display: flex;
    column-gap: 1.25rem;
  }

  .nav__link {
    height: 100%;
    padding-inline: 0;
    padding-block: 1rem;
    justify-content: initial;
    column-gap: .25rem;
  }
  .nav__link:hover {
    background-color: transparent;
  }

  .dropdown__item,
  .dropdown__subitem {
    position: relative;
  }

  .dropdown__menu,
  .dropdown__submenu {
    max-height: initial;
    overflow: initial;
    position: absolute;
    left: 0;
    top: 3rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity .1s, top 0s;

  }

  .dropdown__link,
  .dropdown__sublink {
    padding-inline: 1rem;
    font-size: .9rem;
    width: 300px;
    background: transparent;
  }

  .dropdown__subitem .dropdown__link {
    padding-inline: 1rem;
  }

  .dropdown__submenu {
    position: absolute;
    left: 100%;
    top: .5rem;
  }

  /* Show dropdown menu */
  .dropdown__item:hover .dropdown__menu {
    opacity: 1;
    top: 4rem;
    pointer-events: initial;
    transition: top 0s;
  }

  /* Show dropdown submenu */
  .dropdown__subitem:hover > .dropdown__submenu {
    opacity: 1;
    top: 0;
    pointer-events: initial;
    transition: top 0s;
  }
}



/* === Submenu: JS-controlled (desktop only) === */
@media (min-width: 1118px) {

  /* Neutralize old hover rule */
  .dropdown__subitem:hover > .dropdown__submenu {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Baseline hidden state (always absolute so no jumping) */
  .dropdown__submenu {
    position: absolute;
    left: 100%;
    top: 0;                /* <-- lock at 0 to stop flicker */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(0); /* stable baseline */
    transition: opacity .18s ease, visibility 0s linear .18s;
    will-change: opacity;
  }

  /* Show when JS adds .open */
  .dropdown__subitem.open > .dropdown__submenu {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    transition-delay: 0s !important;
  }
}




.voucher-store-button {
  position: relative;
  padding-inline: .8rem;
  padding-block: .4rem;
  border-radius: 10vw;
  corner-shape: squircle;
  background-color: var(--clr-primary);
  border: none;
  z-index: 10000;
  column-gap: .25rem;
  margin-block: 1rem;
  font-weight: bold;

  transition: all 400ms ease;

  @media(width < 1000px) {
    margin-left: 1.25rem;
  }
}

.voucher-store-button:hover {
  background-color: #00317a;
  border-radius: 100vw;
}

.voucher-store-button a {
  display: flex;
  gap: .5rem;
  align-items: center;
  text-decoration: none;
  color: #fff;
}


